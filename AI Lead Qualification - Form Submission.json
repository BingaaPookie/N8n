    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-5.6-luna', input: 'You are an expert B2B sales lead qualification agent. Analyze the following potential customer and calculate a lead score from 0 to 100.\\n\\nLead Name: ' + $json.name + '\\nEmail: ' + $json.email + '\\nCompany: ' + $json.company + '\\nPhone: ' + $json.phone + '\\nBudget: ' + $json.budget + '\\nService: ' + $json.service + '\\nTimeline: ' + $json.timeline + '\\nMessage: ' + $json.message + '\\n\\nQualification rules:\\nHOT = 75-100\\nWARM = 40-74\\nCOLD = 0-39\\n\\nReturn ONLY valid JSON with exactly these fields:\\nscore: number\\nqualification: HOT, WARM, or COLD\\nreason: short explanation\\nrecommended_action: recommended sales action' }) }}",
        "options": {}
      },
      "id": "e1f3e4aa-f711-4033-aeb0-0a000126cbf6",
      "name": "AI Lead Analyzer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        176,
        -112
      ],
      "credentials": {
        "openAiApi": {
          "id": "ngxjvCKvs9709yJT",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nlet text = response.output_text || '';\n\nif (!text && response.output) {\n  for (const item of response.output) {\n    if (item.content) {\n      for (const content of item.content) {\n        if (content.text) text += content.text;\n      }\n    }\n  }\n}\n\nlet ai;\ntry {\n  ai = JSON.parse(text);\n} catch (error) {\n  ai = {\n    score: 0,\n    qualification: 'COLD',\n    reason: 'AI response could not be parsed.',\n    recommended_action: 'Review lead manually.'\n  };\n}\n\nconst lead = $('Prepare Lead').first().json;\n\nreturn [{\n  json: {\n    ...lead,\n    lead_score: ai.score,\n    qualification: ai.qualification,\n    ai_reason: ai.reason,\n    recommended_action: ai.recommended_action,\n    qualified_at: new Date().toISOString()\n  }\n}];"
      },
